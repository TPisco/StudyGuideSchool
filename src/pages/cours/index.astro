---
import Base from '../../layouts/Base.astro';
import { cardsForCourse, getAllBundles } from '../../lib/content';
import { routes } from '../../lib/paths';

const bundles = await getAllBundles();
---

<Base title="Cours" wide>
  <header class="mb-7">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Mes cours</h1>
    <p class="mt-2 text-sm" style="color: var(--text-muted);">
      {bundles.length} cours générés à partir de mes documents.
    </p>
  </header>

  <div class="space-y-4">
    {
      bundles.map((b) => {
        const cards = cardsForCourse(b).length;
        const questions = b.chapters.reduce(
          (n, ch) => n + ch.data.quiz.questions.length + ch.data.test.questions.length,
          0,
        );
        const exercises = b.chapters.reduce((n, ch) => n + ch.data.exercises.length, 0);
        return (
          <article class="card overflow-hidden" data-accent={b.course.accent}>
            <a href={routes.course(b.id)} class="block p-5 transition-colors hover:bg-[var(--accent-soft)]">
              <div class="mb-2 flex flex-wrap items-center gap-1.5">
                <span class="chip chip-accent">{b.course.code}</span>
                <span class="chip">{b.course.term}</span>
                {b.course.sample && <span class="chip chip-warn">démonstration</span>}
              </div>
              <h2 class="text-xl font-semibold tracking-tight">{b.course.title}</h2>
              <p class="mt-1.5 max-w-3xl text-sm leading-relaxed" style="color: var(--text-muted);">
                {b.course.description}
              </p>
              <div class="mt-3 flex flex-wrap gap-1.5 text-[0.7rem]">
                <span class="chip">{b.chapters.length} chapitres</span>
                <span class="chip">{questions} questions</span>
                <span class="chip">{exercises} exercices</span>
                <span class="chip">{cards} cartes</span>
              </div>
            </a>
            <div class="flex flex-wrap gap-1.5 border-t px-5 py-2.5" style="border-color: var(--border);">
              <a href={routes.roadmap(b.id)} class="btn btn-sm">Parcours</a>
              <a href={routes.exam(b.id)} class="btn btn-sm">Examen blanc</a>
              <a href={routes.coverage(b.id)} class="btn btn-sm">Couverture</a>
            </div>
          </article>
        );
      })
    }
  </div>
</Base>
