---
import Base from '../../../../../layouts/Base.astro';
import QuizEngine from '../../../../../components/react/QuizEngine';
import { getAllBundles } from '../../../../../lib/content';
import { routes } from '../../../../../lib/paths';

export async function getStaticPaths() {
  const bundles = await getAllBundles();
  return bundles.flatMap((b) =>
    b.chapters.map((ch) => ({ params: { course: b.id, chapter: ch.slug }, props: { bundle: b, chapter: ch } })),
  );
}

const { bundle, chapter } = Astro.props;
const test = chapter.data.test;
const questions = test.questions.map((q) => ({ ...q, chapterKey: chapter.key, chapterNumber: chapter.number }));
---

<Base title={`Test — ${chapter.title}`} accent={bundle.course.accent}>
  <nav aria-label="Fil d'Ariane" class="mb-5 flex flex-wrap items-center gap-1.5 text-sm" style="color: var(--text-faint);">
    <a href={routes.course(bundle.id)} class="hover:underline">{bundle.course.code}</a>
    <span aria-hidden="true">/</span>
    <a href={routes.chapter(bundle.id, chapter.slug)} class="hover:underline">Chapitre {chapter.number}</a>
    <span aria-hidden="true">/</span>
    <span>Test</span>
  </nav>

  <h1 class="mb-2 text-2xl font-bold tracking-tight">{test.title ?? 'Test'} — {chapter.title}</h1>
  <p class="mb-5 text-sm" style="color: var(--text-muted);">
    Un score d'au moins 85&nbsp;% marque le chapitre comme maîtrisé.
  </p>

  <QuizEngine
    client:load
    courseId={bundle.id}
    mode="test"
    title={test.title ?? `Test du chapitre ${chapter.number}`}
    instructions={test.instructions}
    questions={questions}
    chapterKey={chapter.key}
    homeHref={routes.chapter(bundle.id, chapter.slug)}
  />
</Base>
