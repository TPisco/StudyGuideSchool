---
import Base from '../layouts/Base.astro';
import SearchApp from '../components/react/SearchApp';
import { path } from '../lib/paths';
---

<Base title="Recherche">
  <header class="mb-6">
    <h1 class="text-2xl font-bold tracking-tight sm:text-3xl">Recherche</h1>
    <p class="mt-2 text-sm" style="color: var(--text-muted);">
      Recherche plein texte sur tous les cours, entièrement côté client.
    </p>
  </header>

  <SearchApp client:load indexUrl={path('/api/recherche.json')} />
</Base>
